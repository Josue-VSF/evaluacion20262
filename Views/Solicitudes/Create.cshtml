@model evaluacion20262.Models.SolicitudServicio
@{
    ViewData["Title"] = "Registrar Solicitud";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-clipboard-plus me-2"></i>Registrar Solicitud de Servicio</h4>
            </div>
            <div class="card-body p-4">
                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Mensaje"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Cliente" class="form-label fw-semibold">Cliente</label>
                        <input asp-for="Cliente" class="form-control" placeholder="Nombre del cliente" />
                        <span asp-validation-for="Cliente" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" placeholder="Número de teléfono" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Distrito" class="form-label fw-semibold">Distrito</label>
                        <input asp-for="Distrito" class="form-control" placeholder="Distrito de ubicación" />
                        <span asp-validation-for="Distrito" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TipoServicio" class="form-label fw-semibold">Tipo de Servicio</label>
                        <select asp-for="TipoServicio" class="form-select">
                            <option value="">-- Seleccione --</option>
                            <option value="Instalación">Instalación</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                            <option value="Revisión">Revisión</option>
                            <option value="Fuga">Fuga</option>
                        </select>
                        <span asp-validation-for="TipoServicio" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalle de la solicitud"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg flex-fill"><i class="bi bi-check-lg me-1"></i> Registrar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg flex-fill">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
}
