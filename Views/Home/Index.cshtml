@{
    ViewData["Title"] = "Inicio - TecnoGas Hogar";
}

<div class="position-relative overflow-hidden p-5 mb-4 rounded-4 shadow-lg text-white"
     style="background: linear-gradient(135deg, #0d6efd 0%, #0a3d91 100%);">
    <div class="container-fluid py-4 position-relative" style="z-index:1;">
        <h1 class="display-5 fw-bold">TecnoGas Hogar 🛠️</h1>
        <p class="col-md-8 fs-4 mb-3" style="opacity:.85;">Portal interno de registro y control de solicitudes de servicio técnico para gasodomésticos.</p>
        <hr class="my-4 border-2 opacity-25 w-25 ms-0">
        <p class="col-md-8 mb-4" style="opacity:.9;">Gestiona eficientemente las instalaciones, mantenimientos y revisiones de tus clientes sin perder información.</p>
        <a class="btn btn-light btn-lg mt-1 fw-semibold" asp-controller="Solicitudes" asp-action="Index" role="button">Ver Solicitudes Registradas</a>
        <a class="btn btn-outline-light btn-lg mt-1 ms-2 fw-semibold" asp-controller="Solicitudes" asp-action="Create" role="button">+ Nueva Solicitud</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="display-5 text-primary mb-2"><i class="bi bi-wrench-adjustable"></i></div>
                <h5 class="fw-bold mb-1">Instalación</h5>
                <p class="text-muted mb-0">Instalación segura de gasodomésticos para tu hogar.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="display-5 text-warning mb-2"><i class="bi bi-gear"></i></div>
                <h5 class="fw-bold mb-1">Mantenimiento</h5>
                <p class="text-muted mb-0">Mantenimiento preventivo y correctivo de equipos.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="display-5 text-danger mb-2"><i class="bi bi-fire"></i></div>
                <h5 class="fw-bold mb-1">Revisión y Fugas</h5>
                <p class="text-muted mb-0">Detección y atención de fugas para tu seguridad.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
}
